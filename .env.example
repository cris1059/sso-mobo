# Base de datos MoboNet (servidor UAT 192.168.10.150)
MYSQL_HOST=192.168.10.150
MYSQL_PORT=3306
MYSQL_USER=aec
MYSQL_PASS=tu_password_aqui
MYSQL_DB=SSOMOBO

# Fuente de empleados (solo lectura)
SYNC_SOURCE_HOST=192.168.10.80
SYNC_SOURCE_PORT=3306
SYNC_SOURCE_USER=aec
SYNC_SOURCE_PASS=tu_password_solo_lectura
SYNC_SOURCE_DB=sync

# Keycloak
KC_ADMIN=admin
KC_ADMIN_PASS=admin
KC_REALM=mobo

# SMTP SendGrid (recuperación de contraseña Keycloak)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=tu_api_key_sendgrid
SMTP_FROM=no-reply@mobonet.mx
SMTP_FROM_NAME=MOBO SSO

# Paths: /auth (Keycloak) y /admin (consola)
# Público (proxy Abraham + SSL):
KC_HTTP_RELATIVE_PATH=/auth
KC_PUBLIC_URL=https://sso.mobo.com.mx/auth
KEYCLOAK_URL=https://sso.mobo.com.mx/auth/realms/mobo
KC_HOSTNAME=sso.mobo.com.mx
KC_HOSTNAME_PORT=-1
KC_DB_HOST=host.docker.internal
KC_PROXY=edge
KC_PORT=8089

# Consola admin
ADMIN_BASE_PATH=/admin
ADMIN_PUBLIC_URL=https://sso.mobo.com.mx/admin
ADMIN_PORT=3010
ADMIN_PORTAL_SECRET=admin-portal-secret
SESSION_SECRET=cambia-este-secreto-en-produccion
# TTL del token Bearer de seeders (segundos). Default 3600.
SEED_TOKEN_TTL_SEC=3600
