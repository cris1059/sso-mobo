PORT=3010
SESSION_SECRET=cambia-este-secreto-en-produccion

# TTL del token Bearer de seeders (segundos). Default 3600.
SEED_TOKEN_TTL_SEC=3600

# Keycloak OIDC — consola admin (realm mobo)
KEYCLOAK_URL=http://192.168.10.150:8089/realms/mobo
CLIENT_ID=admin-portal
CLIENT_SECRET=admin-portal-secret
REDIRECT_URL=http://192.168.10.150:3010/callback

# Keycloak Admin API — sincronización de usuarios
KC_BASE_URL=http://192.168.10.150:8089
KC_ADMIN=admin
KC_ADMIN_PASS=admin
KC_REALM=mobo

# MySQL MoboNet (userSSO / roleSSO) — también se lee desde ../.env
MYSQL_HOST=192.168.10.150
MYSQL_PORT=3306
MYSQL_USER=aec
MYSQL_PASS=tu_password_aqui
MYSQL_DB=SSOMOBO
